# Template file for 'arxy'
# Uso: copiar esta carpeta 'arxy/' a void-packages/srcpkgs/ y compilar:
#   ./xbps-src pkg arxy
pkgname=arxy
version=0.5.0
revision=2
# archs="noarch"  # noarch no soportado por z-repo/check_outdated.py (skipped silencioso)
# build_style=meta # build_style=meta deprecado en xbps-src, reemplazado por instalación directa (FILESDIR)
short_desc="Subsistema Arch minimalista para correr software glibc en cualquier distro"
maintainer="Dicov <srdicov@gmail.com>"
license="GPL-3.0-or-later"
homepage="https://github.com/SrDicov/arxy"
depends="bash bubblewrap curl tar zstd xz gzip file desktop-file-utils minisign sudo"
# No pisar la config del usuario al actualizar (puede anclar URL/SHA).
# arxy.pub NO es conf_files: es trust root y el paquete la renueva.
# R5-H2: sin bridge (equivale a install.sh --without-bridge; el daemon
# requiere compilar bridge/ aparte). Siguiente tras instalar: sudo arxy setup.
conf_files="/etc/arxy/arxy.conf"

do_install() {
	vbin ${FILESDIR}/arxy
	ln -sf arxy ${DESTDIR}/usr/bin/axy
	vinstall ${FILESDIR}/arxy.conf 644 etc/arxy/
	vinstall ${FILESDIR}/arxy.pub 644 etc/arxy/
}
